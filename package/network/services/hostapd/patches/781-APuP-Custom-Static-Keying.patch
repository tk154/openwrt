 #ifdef UBUS_SUPPORT
 #	include "ubus.h"
@@ -31,6 +34,80 @@
 #	include "ucode.h"
 #endif
 
+/* Experimental, locally administered OUI: replace with an assigned one */
+#define APUP_VENDOR_OUI 0x024150
+#define APUP_SESSION_VENDOR_TYPE ((APUP_VENDOR_OUI << 8) | 0x01)
+#define APUP_SESSION_IE_VERSION 1
+/* vendor type (4) + version (1) + nonce */
+#define APUP_SESSION_IE_LEN (4 + 1 + WPA_NONCE_LEN)
+
+void apup_init_session(struct hostapd_data *hapd)
+{
+	struct hostapd_bss_config *conf = hapd->conf;
+	u8 *ie = NULL;
+
+	conf->apup_session_nonce_set = false;
+	if (!conf->wpa)
+		return;
+
+	if (random_get_bytes(conf->apup_session_nonce, WPA_NONCE_LEN) < 0) {
+		wpa_printf(MSG_ERROR, "APuP: Failed to generate session nonce");
+		return;
+	}
+
+	if (conf->vendor_elements)
+		ie = (u8 *) get_vendor_ie(wpabuf_head(conf->vendor_elements),
+		                          wpabuf_len(conf->vendor_elements),
+		                          APUP_SESSION_VENDOR_TYPE);
+	if (ie && ie[1] >= APUP_SESSION_IE_LEN) {
+		os_memcpy(ie + 7, conf->apup_session_nonce, WPA_NONCE_LEN);
+	} else {
+		if (wpabuf_resize(&conf->vendor_elements,
+		                  2 + APUP_SESSION_IE_LEN) < 0) {
+			wpa_printf(MSG_ERROR,
+			           "APuP: Failed to add session element to beacons");
+			return;
+		}
+		wpabuf_put_u8(conf->vendor_elements, WLAN_EID_VENDOR_SPECIFIC);
+		wpabuf_put_u8(conf->vendor_elements, APUP_SESSION_IE_LEN);
+		wpabuf_put_be32(conf->vendor_elements, APUP_SESSION_VENDOR_TYPE);
+		wpabuf_put_u8(conf->vendor_elements, APUP_SESSION_IE_VERSION);
+		wpabuf_put_data(conf->vendor_elements, conf->apup_session_nonce,
+		                WPA_NONCE_LEN);
+	}
+
+	conf->apup_session_nonce_set = true;
+	wpa_printf(MSG_INFO, "APuP: Advertising new session nonce in beacons");
+}
+
+/* Returns the peer session nonce, or NULL if the peer does not advertise one */
+static const u8 * apup_peer_session_nonce(const struct ieee80211_mgmt *mgmt,
+                                          size_t len)
+{
+	size_t hdr_len = IEEE80211_HDRLEN + sizeof(mgmt->u.beacon);
+	const u8 *ie;
+
+	if (len < hdr_len)
+		return NULL;
+
+	ie = get_vendor_ie(mgmt->u.beacon.variable, len - hdr_len,
+	                   APUP_SESSION_VENDOR_TYPE);
+	if (!ie || ie[1] < APUP_SESSION_IE_LEN ||
+	    ie[6] != APUP_SESSION_IE_VERSION)
+		return NULL;
+
+	return ie + 7;
+}
+
+static bool apup_same_session(const struct sta_info *sta, const u8 *peer_nonce)
+{
+	if (!peer_nonce)
+		return !sta->apup_peer_nonce_set;
+
+	return sta->apup_peer_nonce_set &&
+	       !os_memcmp(sta->apup_peer_nonce, peer_nonce, WPA_NONCE_LEN);
+}
+
 void apup_process_beacon(struct hostapd_data *hapd,
               const struct ieee80211_mgmt *mgmt, size_t len,
               const struct ieee802_11_elems *elems )
@@ -47,9 +124,21 @@ void apup_process_beacon(struct hostapd_
 	        os_memcmp(elems->ssid, hapd->conf->ssid.ssid, elems->ssid_len))
 		return;
 
+	const u8 *peer_nonce = hapd->conf->wpa ?
+		apup_peer_session_nonce(mgmt, len) : NULL;
+
 	struct sta_info* sta_ret = ap_get_sta(hapd, mgmt->bssid);
-	if (sta_ret)
-		return;
+	if (sta_ret) {
+		if (!hapd->conf->wpa || apup_same_session(sta_ret, peer_nonce))
+			return;
+
+		/* The peer restarted: drop its station, keys and replay counters */
+		wpa_printf(MSG_INFO,
+		           "apup_process_beacon(...) APuP peer " MACSTR
+		           " started a new session, re-adding it",
+		           MAC2STR(mgmt->bssid));
+		ap_free_sta(hapd, sta_ret);
+	}
 
 	sta_ret = ap_sta_add(hapd, mgmt->bssid);
 	if (!sta_ret)
@@ -59,6 +148,11 @@ void apup_process_beacon(struct hostapd_
 		return;
 	}
 
+	if (peer_nonce) {
+		os_memcpy(sta_ret->apup_peer_nonce, peer_nonce, WPA_NONCE_LEN);
+		sta_ret->apup_peer_nonce_set = true;
+	}
+
 	/* TODO: this has been added just to making compiler happy after breaking
 	 * changes introduced in 11a607d12 and 7855b6d60 to support
 	 * IEEE80211BE Multi Link Operation. Look at these commits with more time and
@@ -79,8 +80,7 @@ void apup_process_beacon(struct hostapd_
 	sta_ret->flags |= WLAN_STA_AUTH;
 	wpa_auth_sm_event(sta_ret->wpa_sm, WPA_AUTH);
 
-	/* TODO: Investigate if supporting WPA or other encryption method is
-	 * possible */
+	/* We use WLAN_AUTH_OPEN at the MAC level but inject PTK below if WPA is enabled */
 	sta_ret->auth_alg = WLAN_AUTH_OPEN;
 	mlme_authenticate_indication(hapd, sta_ret);
 
@@ -161,6 +161,36 @@ void apup_process_beacon(struct hostapd_
 	int mRet = hostapd_set_wds_sta(
 	            hapd, mIfname, mgmt->bssid, sta_ret->aid, 1);
 
+	if (hapd->conf->wpa && hapd->conf->ssid.wpa_psk) {
+		int cipher = wpa_pick_pairwise_cipher(hapd->conf->wpa_pairwise, 0);
+		u8 zero_nonce[WPA_NONCE_LEN];
+		const u8 *own_n = zero_nonce, *peer_n = zero_nonce;
+		bool per_session = peer_nonce && hapd->conf->apup_session_nonce_set;
+		struct wpa_ptk ptk;
+
+		os_memset(zero_nonce, 0, WPA_NONCE_LEN);
+		os_memset(&ptk, 0, sizeof(ptk));
+		
+		/* Peers without session nonces keep the legacy all-zero nonces */
+		if (per_session) {
+			own_n = hapd->conf->apup_session_nonce;
+			peer_n = peer_nonce;
+		}
+
+		wpa_pmk_to_ptk(hapd->conf->ssid.wpa_psk->psk, PMK_LEN,
+		               "Pairwise key expansion",
+		               hapd->own_addr, mgmt->bssid,
+		               own_n, peer_n, &ptk,
+		               hapd->conf->wpa_key_mgmt,
+		               cipher, NULL, 0, 0);
+		
+		hostapd_drv_set_key(hapd->conf->iface, hapd, wpa_cipher_to_alg(cipher),
+		                    mgmt->bssid, 0, 0, 1, NULL, 0, ptk.tk, ptk.tk_len, KEY_FLAG_PAIRWISE_RX_TX);
+		forced_memzero(&ptk, sizeof(ptk));
+		wpa_printf(MSG_INFO, "apup_process_beacon(...) Injected %s PTK for APuP peer",
+		           per_session ? "per-session" : "static");
+	}
+
 	wpa_printf(MSG_INFO,
 	           "apup_process_beacon(...) Added APuP peer at %s with flags: %d,"
